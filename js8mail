#!/usr/bin/env bash
set -euo pipefail

# Guided launcher for the development checkout.  It deliberately keeps the
# daemon's normal defaults in one place while making first-run failures useful
# to an operator who has not managed a Python environment before.
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="${SCRIPT_DIR}/.venv"
MARKER="${VENV_DIR}/.js8mail-installed"
RUNTIME_DIR="${SCRIPT_DIR}/.js8mail"
PID_FILE="${RUNTIME_DIR}/js8mail.pid"
LOG_FILE="${RUNTIME_DIR}/js8mail.log"
cd "${SCRIPT_DIR}"

api_host="127.0.0.1"
api_port="2442"
ui_host="127.0.0.1"
ui_port="8765"
assume_yes="${JS8MAIL_ASSUME_YES:-0}"
check_only=0
background=1
api_status=""
replacement_notice=""
daemon_args=()

usage() {
    cat <<'EOF'
Usage: ./js8mail [launcher options] [daemon options]

Launcher options:
  --yes          Do not ask before installing the project in .venv
  --no-install   Refuse to install or repair dependencies
  --check-only   Check Python, dependencies, and the JS8Call API, then exit
  --foreground   Run in this terminal and show live daemon output
  --background   Run detached in the background (the default)

Normal daemon options are passed through. Defaults are:
  JS8Call API: 127.0.0.1:2442
  Web UI:      http://127.0.0.1:8765
  TX mode:     automatic
EOF
}

no_install=0
while (($#)); do
    case "$1" in
        --yes) assume_yes=1; shift ;;
        --no-install) no_install=1; shift ;;
        --check-only) check_only=1; shift ;;
        --foreground) background=0; shift ;;
        --background) background=1; shift ;;
        --help|-h) usage; exit 0 ;;
        --host) api_host="$2"; daemon_args+=("$1" "$2"); shift 2 ;;
        --host=*) api_host="${1#*=}"; daemon_args+=("$1"); shift ;;
        --port) api_port="$2"; daemon_args+=("$1" "$2"); shift 2 ;;
        --port=*) api_port="${1#*=}"; daemon_args+=("$1"); shift ;;
        --ui-host) ui_host="$2"; daemon_args+=("$1" "$2"); shift 2 ;;
        --ui-host=*) ui_host="${1#*=}"; daemon_args+=("$1"); shift ;;
        --ui-port) ui_port="$2"; daemon_args+=("$1" "$2"); shift 2 ;;
        --ui-port=*) ui_port="${1#*=}"; daemon_args+=("$1"); shift ;;
        *) daemon_args+=("$1"); shift ;;
    esac
done

if ! command -v python3 >/dev/null 2>&1; then
    echo "Python 3 is not installed. Install Python 3.12 or newer, then run ./js8mail again." >&2
    echo "Fedora: sudo dnf install python3 python3-pip" >&2
    echo "Debian/Ubuntu: sudo apt install python3 python3-venv python3-pip" >&2
    exit 1
fi

if ! python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 12) else 1)'; then
    echo "JS8Mail requires Python 3.12 or newer." >&2
    python3 --version >&2
    exit 1
fi

if [[ ! -x "${VENV_DIR}/bin/python" ]]; then
    if ((no_install)); then
        echo "The JS8Mail virtual environment is missing and --no-install was supplied." >&2
        exit 1
    fi
    echo "Creating the local JS8Mail virtual environment..."
    if ! python3 -m venv "${VENV_DIR}"; then
        echo "Could not create .venv. Your OS may need its Python venv package." >&2
        echo "Fedora: sudo dnf install python3-pip" >&2
        echo "Debian/Ubuntu: sudo apt install python3-venv" >&2
        exit 1
    fi
fi

needs_install=0
if [[ ! -f "${MARKER}" || "${SCRIPT_DIR}/pyproject.toml" -nt "${MARKER}" ]]; then
    needs_install=1
fi
# A marker is only an optimisation.  Repair a partially-created environment
# when the package itself can no longer be imported.
if ! "${VENV_DIR}/bin/python" -c 'import js8mail' >/dev/null 2>&1; then
    needs_install=1
fi

if ((needs_install)); then
    if ((no_install)); then
        echo "JS8Mail dependencies are not installed or are out of date." >&2
        echo "Run ./js8mail and allow the local project installation, or use --yes." >&2
        exit 1
    fi
    if ((assume_yes == 0)); then
        if [[ ! -t 0 ]]; then
            echo "JS8Mail needs to install/update its local .venv, but no interactive terminal is available." >&2
            echo "Review the command, then rerun with JS8MAIL_ASSUME_YES=1 or --yes." >&2
            exit 1
        fi
        read -r -p "Install/update JS8Mail in ${VENV_DIR}? [Y/n] " answer
        if [[ "${answer}" =~ ^[Nn] ]]; then
            echo "Dependency installation cancelled."
            exit 1
        fi
    fi
    echo "Installing JS8Mail into the local virtual environment..."
    "${VENV_DIR}/bin/python" -m pip install --upgrade pip
    "${VENV_DIR}/bin/python" -m pip install -e "${SCRIPT_DIR}"
    touch "${MARKER}"
fi

if ! "${VENV_DIR}/bin/python" - "${api_host}" "${api_port}" <<'PY'
import socket
import sys

try:
    with socket.create_connection((sys.argv[1], int(sys.argv[2])), timeout=1.0):
        pass
except OSError:
    raise SystemExit(1)
PY
then
    cat >&2 <<EOF
JS8Call API is not reachable at ${api_host}:${api_port}.

Start JS8Call first, then enable its documented TCP/JSON API in the JS8Call
networking/API settings. Use loopback address ${api_host} and port ${api_port}.
JS8Mail will still start and keep retrying, so this is a warning rather than
an installation failure.
EOF
else
    api_status="JS8Call API detected at ${api_host}:${api_port}."
fi

if ((check_only)); then
    echo "Checks complete. Web UI would be: http://${ui_host}:${ui_port}"
    exit 0
fi

stop_existing_daemons() {
    local -a daemon_pids=()
    local pid process_command

    if [[ -f "${PID_FILE}" ]]; then
        pid="$(<"${PID_FILE}")"
        if [[ "${pid}" =~ ^[0-9]+$ ]]; then
            daemon_pids+=("${pid}")
        fi
    fi
    while read -r pid; do
        [[ "${pid}" =~ ^[0-9]+$ ]] && daemon_pids+=("${pid}")
    done < <(pgrep -f -- 'js8mail\.tools\.app' || true)

    local -a unique_pids=()
    for pid in "${daemon_pids[@]}"; do
        process_command="$(ps -p "${pid}" -o args= 2>/dev/null || true)"
        [[ "${process_command}" == *"js8mail.tools.app"* ]] || continue
        if [[ ! " ${unique_pids[*]} " == *" ${pid} "* ]]; then
            unique_pids+=("${pid}")
        fi
    done

    if ((${#unique_pids[@]} == 0)); then
        rm -f "${PID_FILE}"
        return
    fi

    local -a failed_pids=()
    for pid in "${unique_pids[@]}"; do
        kill "${pid}" 2>/dev/null || true
    done
    for _ in {1..50}; do
        local still_running=0
        for pid in "${unique_pids[@]}"; do
            process_command="$(ps -p "${pid}" -o stat= 2>/dev/null || true)"
            [[ -n "${process_command}" && "${process_command}" != Z* ]] && still_running=1
        done
        ((still_running == 0)) && break
        sleep 0.1
    done
    for pid in "${unique_pids[@]}"; do
        process_command="$(ps -p "${pid}" -o stat= 2>/dev/null || true)"
        if [[ -n "${process_command}" && "${process_command}" != Z* ]]; then
            kill -KILL "${pid}" 2>/dev/null || true
            sleep 0.1
            process_command="$(ps -p "${pid}" -o stat= 2>/dev/null || true)"
            [[ -n "${process_command}" && "${process_command}" != Z* ]] && failed_pids+=("${pid}")
        fi
    done
    rm -f "${PID_FILE}"
    if ((${#failed_pids[@]})); then
        replacement_notice="Existing JS8Mail daemon(s) found (PIDs: ${unique_pids[*]}). Could not stop PID(s): ${failed_pids[*]}."
    else
        replacement_notice="Existing JS8Mail daemon(s) found (PIDs: ${unique_pids[*]}) and stopped before restart."
    fi
}

mkdir -p "${RUNTIME_DIR}"
stop_existing_daemons

print_startup_banner() {
    local title="$1"
    local daemon_pid="${2:-}"

    printf '\n============================================================\n'
    printf '  %s\n\n' "${title}"
    printf '  BROWSE TO: http://%s:%s\n\n' "${ui_host}" "${ui_port}"
    if [[ -n "${daemon_pid}" ]]; then
        printf '  PID: %s\n' "${daemon_pid}"
        printf '  Log: %s\n' "${LOG_FILE}"
        printf '  Stop: kill %s\n' "${daemon_pid}"
    fi
    [[ -n "${api_status}" ]] && printf '  %s\n' "${api_status}"
    [[ -n "${replacement_notice}" ]] && printf '  %s\n' "${replacement_notice}"
    if [[ -z "${daemon_pid}" ]]; then
        printf '  Press Ctrl+C to stop.\n'
    fi
    printf '============================================================\n'
}

if ((background)); then
    nohup "${VENV_DIR}/bin/python" -m js8mail.tools.app "${daemon_args[@]}" \
        >>"${LOG_FILE}" 2>&1 </dev/null &
    daemon_pid=$!
    printf '%s\n' "${daemon_pid}" >"${PID_FILE}"
    sleep 0.2
    if ! kill -0 "${daemon_pid}" 2>/dev/null; then
        echo "JS8Mail failed to stay running. Recent log output:" >&2
        tail -n 20 "${LOG_FILE}" >&2 || true
        rm -f "${PID_FILE}"
        exit 1
    fi
    print_startup_banner "JS8MAIL IS RUNNING IN THE BACKGROUND" "${daemon_pid}"
else
    print_startup_banner "JS8MAIL IS STARTING IN THE FOREGROUND"
    exec "${VENV_DIR}/bin/python" -m js8mail.tools.app "${daemon_args[@]}"
fi
